@{
    Layout = "~/Areas/JobSeeker/Views/Shared/_JobSeekerLayout.cshtml";
    ViewData["Title"] = "داشبورد";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">داشبورد کارجو</h1>
    <a href="/JobSeeker/Jobs" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fa-solid fa-briefcase fa-sm text-white-50"></i> جستجوی شغل
    </a>
</div>

<div class="row">

    <!-- درخواست‌های ارسالی -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-start-primary border-start-4 border-start-4 shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs fw-bold text-primary text-uppercase mb-1">درخواست‌های ارسالی</div>
                        <div class="h5 mb-0 fw-bold text-gray-800">12</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-paper-plane fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- در حال بررسی -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-start-warning border-start-4 border-start-4 shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1">در حال بررسی</div>
                        <div class="h5 mb-0 fw-bold text-gray-800">5</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-clock fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- پذیرفته شده -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-start-success border-start-4 border-start-4 shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs fw-bold text-success text-uppercase mb-1">پذیرفته شده</div>
                        <div class="h5 mb-0 fw-bold text-gray-800">3</div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-calendar-check fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- بازدید از رزومه -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-start-info border-start-4 border-start-4 shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs fw-bold text-info text-uppercase mb-1">بازدید از رزومه</div>
                        <div class="row no-gutters align-items-center">
                            <div class="col-auto">
                                <div class="h5 mb-0 me-3 fw-bold text-gray-800">45</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-eye fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">

    <!-- آخرین درخواست‌ها -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-primary">آخرین درخواست‌های شما</h6>
                <a href="/JobSeeker/MyApplications" class="btn btn-sm btn-outline-primary">مشاهده همه</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>عنوان شغل</th>
                                <th>شرکت</th>
                                <th>تاریخ ارسال</th>
                                <th>وضعیت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>برنامه‌نویس C#</td>
                                <td>شرکت فناوری اطلاعات</td>
                                <td>1405/05/28</td>
                                <td><span class="badge bg-warning text-dark">در حال بررسی</span></td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-primary">مشاهده</a>
                                </td>
                            </tr>
                            <tr>
                                <td>توسعه‌دهنده Full Stack</td>
                                <td>استارتاپ نوآور</td>
                                <td>1405/05/25</td>
                                <td><span class="badge bg-success">پذیرفته شده</span></td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-primary">مشاهده</a>
                                </td>
                            </tr>
                            <tr>
                                <td>توسعه‌دهنده موبایل</td>
                                <td>شرکت دیجیتال مارکتینگ</td>
                                <td>1405/05/20</td>
                                <td><span class="badge bg-danger">رد شده</span></td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-primary">مشاهده</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- پیشنهادات ویژه -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 fw-bold text-warning">پیشنهادات ویژه</h6>
            </div>
            <div class="card-body">
                <div class="mb-3 pb-3 border-bottom">
                    <h6 class="mb-1">برنامه‌نویس ASP.NET Core</h6>
                    <p class="text-muted mb-2 small">شرکت نرم‌افزاری برتر</p>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary">تمام وقت</span>
                        <small class="text-muted">تهران</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-primary w-100">ارسال رزومه</a>
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <h6 class="mb-1">توسعه‌دهنده React</h6>
                    <p class="text-muted mb-2 small">استارتاپ فناوری</p>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-success">دورکاری</span>
                        <small class="text-muted">ریموت</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-primary w-100">ارسال رزومه</a>
                </div>

                <div>
                    <h6 class="mb-1">مهندس DevOps</h6>
                    <p class="text-muted mb-2 small">شرکت ابری</p>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-info">پروژه‌ای</span>
                        <small class="text-muted">اصفهان</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-primary w-100">ارسال رزومه</a>
                </div>
            </div>
        </div>
    </div>
</div>