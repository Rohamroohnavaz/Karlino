@model List<FinalProject_MVC.Areas.JobSeeker.ViewModels.MyApplicationsViewModel>

@{
    Layout = "~/Areas/JobSeeker/Views/Shared/_JobSeekerLayout.cshtml";
    ViewData["Title"] = "درخواست‌های من";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">درخواست‌های من</h1>
    <a href="/JobSeeker/Jobs" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-search fa-sm text-white-50"></i> جستجوی شغل
    </a>
</div>

@if (Model.Any())
{
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">لیست درخواست‌های شما (@Model.Count مورد)</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>عنوان شغل</th>
                            <th>شرکت</th>
                            <th>شهر</th>
                            <th>تاریخ ارسال</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>@app.JobTitle</td>
                                <td>@app.CompanyName</td>
                                <td>@app.City</td>
                                <td>@app.AppliedDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    <span class="badge @app.StatusBadgeClass">@app.Status</span>
                                </td>

                                <td>
                                    @if (app.AdvertisementId.HasValue)
                                    {
                                        <a href="@Url.Action("Details", "Jobs", new { id = app.AdvertisementId.Value })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> مشاهده آگهی
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-body text-center py-5">
            <i class="fas fa-inbox fa-3x text-gray-300 mb-3"></i>
            <h5 class="text-gray-600">هنوز درخواستی ارسال نکرده‌اید</h5>
            <p class="text-muted">برای شروع، به بخش جستجوی شغل بروید و برای موقعیت‌های مورد علاقه‌تان درخواست ارسال کنید.</p>
            <a href="/JobSeeker/Jobs" class="btn btn-primary mt-3">
                <i class="fas fa-search"></i> جستجوی شغل
            </a>
        </div>
    </div>
}