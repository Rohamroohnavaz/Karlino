@model List<MyFinalProject.Infrastructure.DTO.AdminCategoryDto>

@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
}

@if (TempData["Error"] != null)
{
    <div class="sb-error">@TempData["Error"]</div>
}

<div class="sb-table-card">
    <h5>دسته‌بندی‌ها</h5>

    <form asp-area="Admin" asp-controller="Categories" asp-action="Add" method="post" class="sb-add-form">
        <input type="text" name="title" placeholder="عنوان دسته‌بندی..." required />
        <input type="text" name="description" placeholder="توضیحات (اختیاری)" />
        <button type="submit" class="btn-sb btn-sb-primary">افزودن</button>
    </form>

    <table class="sb-table">
        <thead>
            <tr>
                <th>عنوان</th>
                <th>ویرایش</th>
                <th>حذف</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="3" style="text-align:center; color:#858796;">
                        هنوز دسته‌بندی‌ای ثبت نشده
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>
                            <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" method="post" class="sb-edit-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="text" name="title" value="@item.Title" />
                                <input type="text" name="description" value="@item.Description" />
                                <button type="submit" class="btn-sb btn-sb-success">ثبت</button>
                            </form>
                        </td>
                        <td>
                            <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-sb btn-sb-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>