<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - پنل مدیریت</title>

    <!-- ۱. فونت وزیرمتن (همون فونت خودت - دست نخورده) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />

    <!-- ۲. Font Awesome (برای آیکون‌ها) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- ۳. Bootstrap 5 RTL (جدید: برای درست شدن چیدمان کارت‌ها و جدول‌ها) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />

    <!-- ۴. SB Admin 2 CSS (جدید: برای اعمال تم و رنگ‌بندی اصلی) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/css/sb-admin-2.min.css" rel="stylesheet" />

    <!-- ۵. CSS سفارشی خودت -->
    <link rel="stylesheet" href="~/css/admin-sb.css" asp-append-version="true" />
</head>
<body>
    
    <div id="wrapper">

        <aside id="sidebar">
            <a class="sidebar-brand" href="/Admin/Dashboard">
                <i class="fa-solid fa-gear"></i>
                <span>پنل مدیریت</span>
            </a>

            <hr class="sidebar-divider" />

            <div class="sidebar-heading">مدیریت</div>

            <a class="nav-link" href="/Admin/Dashboard">
                <i class="fa-solid fa-gauge"></i><span>داشبورد</span>
            </a>
            <a class="nav-link" href="/Admin/Jobs">
                <i class="fa-solid fa-briefcase"></i><span>آگهی‌ها</span>
            </a>
            <a class="nav-link" href="/Admin/Employers">
                <i class="fa-solid fa-building"></i><span>کارفرماها</span>
            </a>
            <a class="nav-link" href="/Admin/Users">
                <i class="fa-solid fa-users"></i><span>کاربران</span>
            </a>

            <a class="nav-link" href="/Admin/Reports">
                <i class="fa-solid fa-flag"></i><span>گزارش‌ها</span>
            </a>

            <div class="sidebar-heading">تنظیمات</div>

            <a class="nav-link" href="/Admin/Categories">
                <i class="fa-solid fa-tags"></i><span>دسته‌بندی‌ها</span>
            </a>

            <a class="nav-link" href="/Admin/Settings">
                <i class="fa-solid fa-sliders"></i><span>تنظیمات</span>
            </a>

            <hr class="sidebar-divider" />

            <a class="nav-link" href="/">
                <i class="fa-solid fa-arrow-right-from-bracket"></i><span>بازگشت به سایت</span>
            </a>
        </aside>

        <div id="content-wrapper">

            <nav id="topbar">
                <form class="topbar-search">
                    <input type="text" placeholder="جستجو..." />
                    <button type="submit"><i class="fa fa-search"></i></button>
                </form>

                <div class="topbar-actions">
                    <a class="topbar-icon" href="#">
                        <i class="fa-regular fa-bell"></i>
                        <span class="dot"></span>
                    </a>

                    <div class="topbar-user">
                        <i class="fa-solid fa-user"></i>
                        <span>@User.Identity?.Name</span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn-logout" type="submit">خروج</button>
                    </form>
                </div>
            </nav>

            <main class="container-fluid">
                @RenderBody()
            </main>

        </div>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>