<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت</title>

    <style>
        body {
            font-family: Tahoma, Arial;
            background: #f4f6f9;
            margin: 0;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 230px;
            background: #222;
            color: #fff;
            padding: 15px;
        }

        .sidebar h3 {
            color: #fff;
            margin-top: 0;
            margin-bottom: 20px;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar ul li {
            margin-bottom: 10px;
        }

        .sidebar ul li a {
            color: #ddd;
            text-decoration: none;
            display: block;
            padding: 8px 10px;
            border-radius: 6px;
        }

        .sidebar ul li a:hover {
            background: #444;
            color: #fff;
        }

        .main-content {
            flex: 1;
            padding: 20px;
        }

        .card {
            background: #fff;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            margin-left: -10px;
            margin-right: -10px;
        }

        .col-md-3 {
            width: 25%;
            padding: 10px;
            box-sizing: border-box;
        }

        @@media(max-width: 768px) {
            .admin-wrapper {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
            }

            .col-md-3 {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="admin-wrapper">

        <aside class="sidebar">
            <h3>پنل مدیریت</h3>

            <ul>
                <li>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        داشبورد
                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index">
                        کاربران
                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Employers" asp-action="Index">
                        کارفرماها
                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Jobs" asp-action="Index">
                        آگهی‌ها
                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index">
                        دسته‌بندی‌ها
                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Cities" asp-action="Index">
                        شهرها
                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Reports" asp-action="Index">
                        گزارش‌ها
                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Settings" asp-action="Index">
                        تنظیمات
                    </a>
                </li>
            </ul>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>

    </div>

</body>
</html>