@using MyFinalProject.Domain.Entities.Enums
@using MyFinalProject.Domain.Entities.MainModels
@model List<MyFinalProject.Infrastructure.DTO.AdminReportTableDto>

@{
    ViewData["Title"] = "گزارش‌های تخلف";
}

<div class="sb-table-card">
    <h5>گزارش‌های تخلف</h5>

    <table class="sb-table">
        <thead>
            <tr>
                <th>آگهی</th>
                <th>گزارش‌دهنده</th>
                <th>دلیل گزارش</th>
                <th>تاریخ</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" style="text-align:center; color:#858796;">
                        گزارشی ثبت نشده است
                    </td>
                </tr>
            }
            else
            {
                @foreach (var report in Model)
                {
                    <tr>
                        <td>@report.AdvertisementTitle</td>
                        <td>@report.ReporterEmail</td>
                        <td>@report.Reason</td>
                        <td>@DisplayHelper.FormatDate(report.CreatedAt)</td>
                        <td>
                            @switch (report.Status)
                            {
                                case ReportStatus.Pending:
                                    <span class="badge badge-warning">در انتظار بررسی</span>
                                    break;
                                case ReportStatus.Reviewed:
                                    <span class="badge badge-success">بررسی شده</span>
                                    break;
                                case ReportStatus.Dismissed:
                                    <span class="badge badge-secondary">رد شده</span>
                                    break;
                            }
                        </td>
                        <td style="display:flex; gap:.4rem;">
                            @if (report.Status == ReportStatus.Pending)
                            {
                                <form asp-area="Admin" asp-controller="Reports" asp-action="RejectAd" method="post">
                                    <input type="hidden" name="reportId" value="@report.Id" />
                                    <input type="hidden" name="advertisementId" value="@report.AdvertisementId" />
                                    <button type="submit" class="btn-sb btn-sb-danger">رد آگهی</button>
                                </form>

                                <form asp-area="Admin" asp-controller="Reports" asp-action="Dismiss" method="post">
                                    <input type="hidden" name="reportId" value="@report.Id" />
                                    <button type="submit" class="btn-sb btn-sb-success">رد گزارش</button>
                                </form>
                            }
                            else
                            {
                                <span style="color:#858796; font-size:.8rem;">بررسی شده</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>