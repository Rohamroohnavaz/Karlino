@using MyFinalProject.Infrastructure.Repositories.MainRepositories.Interfaces
@inject ISettingRepository SettingRepository

@{
    var settings = (await SettingRepository.GetAllAsync())
        .ToDictionary(s => s.Key, s => s.Value);

    var siteName = settings.ContainsKey("SiteName") ? settings["SiteName"] : "کارلینو";
    var isRegistrationOpen = !settings.ContainsKey("IsRegistrationOpen") || settings["IsRegistrationOpen"] != "false";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @siteName</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin-sb.css" asp-append-version="true" />
</head>
<body>

    <div id="wrapper">

        <!-- ---------- Sidebar ---------- -->
        <aside id="sidebar">
            <a class="sidebar-brand" href="/">
                <i class="fa-solid fa-briefcase"></i>
                <span>@siteName</span>
            </a>

            <hr class="sidebar-divider" />
            <div class="sidebar-heading">منو</div>

            <a class="nav-link" href="/">
                <i class="fa-solid fa-house"></i><span>صفحه اصلی</span>
            </a>
            <a class="nav-link" asp-controller="Advertisement" asp-action="Index">
                <i class="fa-solid fa-briefcase"></i><span>آگهی‌ها</span>
            </a>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("Employer"))
                {
                    <div class="sidebar-heading">پنل کارفرما</div>

                    <a class="nav-link" href="/">
                        <i class="fa-solid fa-gauge"></i><span>داشبورد</span>
                    </a>

                    <a class="nav-link" asp-controller="Advertisement" asp-action="MyAds">
                        <i class="fa-solid fa-list"></i><span>آگهی‌های من</span>
                    </a>

                    <a class="nav-link" asp-controller="Advertisement" asp-action="Create">
                        <i class="fa-solid fa-plus"></i><span>ثبت آگهی جدید</span>
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="sidebar-heading">مدیریت</div>
                    <a class="nav-link" href="/Admin/Dashboard">
                        <i class="fa-solid fa-shield"></i><span>پنل مدیریت</span>
                    </a>
                }
            }

            <hr class="sidebar-divider" />

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="nav-link" style="background:none; border:0; cursor:pointer; width:100%; text-align:right; font-family:inherit;">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i><span>خروج</span>
                    </button>
                </form>
            }
            else
            {
                <a class="nav-link" href="/Account/Login">
                    <i class="fa-solid fa-right-to-bracket"></i><span>ورود</span>
                </a>

                @if (isRegistrationOpen)
                {
                    <a class="nav-link" href="/Account/Register">
                        <i class="fa-solid fa-user-plus"></i><span>ثبت‌نام</span>
                    </a>
                }
            }
        </aside>

        <!-- ---------- Content ---------- -->
        <div id="content-wrapper">

            <nav id="topbar">
                <form class="topbar-search" method="get" asp-controller="Advertisement" asp-action="Index">
                    <input type="text" name="search" placeholder="جستجوی شغل..." />
                    <button type="submit"><i class="fa fa-search"></i></button>
                </form>

                <div class="topbar-actions">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="topbar-user">
                            <i class="fa-solid fa-user"></i>
                            <span>@User.Identity?.Name</span>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" style="color:var(--sb-primary); text-decoration:none; font-size:.85rem; font-weight:700;">
                            ورود / ثبت‌نام
                        </a>
                    }
                </div>
            </nav>

            <main class="container-fluid">
                @RenderBody()
            </main>

        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>