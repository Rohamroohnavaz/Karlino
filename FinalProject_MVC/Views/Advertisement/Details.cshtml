@using FinalProject_MVC.Helpers
@model FinalProject_MVC.Models.AdvertisementViewModel

@{
    ViewData["Title"] = Model.Title;
}

@if (TempData["Success"] != null)
{
    <div class="sb-error" style="background:#d1e7dd; color:#1cc88a;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="sb-error">@TempData["Error"]</div>
}

<div class="sb-table-card">

    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:.6rem;">
        <h5 style="margin:0;">@Model.Title</h5>

        @if (Model.IsActive)
        {
            <span class="badge badge-success">فعال</span>
        }
        
    </div>

    <dl class="sb-details" style="margin-top:1.3rem;">
        <dt>کارفرما</dt>
        <dd>@Model.CompanyName</dd>

        <dt>شهر</dt>
        <dd>@Model.City</dd>

        <dt>تاریخ ثبت</dt>
        <dd>@DisplayHelper.FormatDate(Model.CreatedAt)</dd>
    </dl>

    <h6 style="margin-top:1.5rem; color:var(--sb-secondary);">شرح آگهی</h6>
    <div class="sb-details-desc">@Model.Description</div>

    <div class="sb-actions">
        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("JobSeeker"))
        {
            <button type="button" class="btn-sb btn-sb-success">
                <i class="fa-solid fa-file-arrow-up"></i> ارسال رزومه
            </button>
        }

        <a href="/Advertisements" class="btn-sb btn-sb-primary" style="text-decoration:none;">
            بازگشت به آگهی‌ها
        </a>
    </div>
</div>

@if (ViewBag.IsOwner == true)
{
    <div class="sb-table-card" style="margin-top:1.2rem; border-inline-start:.25rem solid var(--sb-info);">
        <h5>
            <i class="fa-solid fa-pen-to-square"></i> این آگهی شماست
        </h5>

        <div class="sb-actions">
            <a asp-controller="Advertisement" asp-action="Edit" asp-route-id="@Model.Id"
               class="btn-sb btn-sb-info" style="text-decoration:none;">
                <i class="fa-solid fa-pen"></i> ویرایش آگهی
            </a>

            <form asp-controller="Advertisement" asp-action="DeleteConfirmed" asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('آیا از حذف این آگهی مطمئن هستید؟');">
                <button type="submit" class="btn-sb btn-sb-danger">
                    <i class="fa-solid fa-trash"></i> حذف آگهی
                </button>
            </form>

            <a asp-controller="Advertisement" asp-action="MyAds"
               class="btn-sb btn-sb-primary" style="text-decoration:none;">
                بازگشت به آگهی‌های من
            </a>
        </div>
    </div>
}
else if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="sb-table-card" style="margin-top:1.2rem; border-inline-start:.25rem solid var(--sb-danger);">
        <h5 style="color:var(--sb-danger);">
            <i class="fa-solid fa-flag"></i> این آگهی تخلف دارد؟
        </h5>

        <form asp-controller="Report" asp-action="Submit" method="post" style="margin-top:1rem;">
            <input type="hidden" name="advertisementId" value="@Model.Id" />

            <textarea name="reason"
                  placeholder="دلیل گزارش تخلف را بنویسید..."
                  required
                  style="width:100%; border:1px solid var(--sb-border); border-radius:.35rem; padding:.7rem .9rem; min-height:90px; font-family:var(--sb-font); font-size:.88rem; margin-bottom:.7rem;"></textarea>

            <button type="submit" class="btn-sb btn-sb-danger">ثبت گزارش</button>
        </form>
    </div>
}
else
{
    <div class="sb-table-card" style="margin-top:1.2rem; text-align:center; color:var(--sb-secondary); font-size:.85rem;">
        برای گزارش تخلف این آگهی، ابتدا
        <a href="/Account/Login" style="color:var(--sb-primary); font-weight:700;">وارد شوید</a>.
    </div>
}