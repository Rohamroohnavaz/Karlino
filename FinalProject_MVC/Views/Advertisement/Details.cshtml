@model FinalProject_MVC.Models.AdvertisementViewModel

@{
    ViewData["Title"] = "Advertisement Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Advertisement Details</h4>
                    <a asp-action="Index" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>

                <div class="card-body">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                    }

                    <div class="row mb-4">
                        <div class="col-12">
                            <h2 class="text-primary">@Model.Title</h2>
                            <h5 class="text-muted">@Model.CompanyName</h5>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Province:</strong>
                            <p>@Model.Province</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>City:</strong>
                            <p>@Model.City</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Salary:</strong>
                            <p class="text-success fw-bold">@Model.Salary Tooman</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Expire Date:</strong>
                            <p>@(Model.ExpireDate.Year > 1 ? Model.ExpireDate.ToString("yyyy/MM/dd") : "Unspecified")</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Created At:</strong>
                            <p>@(Model.CreatedAt.Year > 1 ? Model.CreatedAt.ToString("yyyy/MM/dd") : "Unspecified")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Status:</strong>
                            <p>
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </p>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <h5 class="text-primary">Description</h5>
                        <p class="lead" style="white-space: pre-wrap;">@Model.Description</p>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-list"></i> Back to List
                        </a>

                        <div>
                            <a href="#" class="btn btn-warning me-2">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a href="#" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>