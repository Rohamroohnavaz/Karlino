@using FinalProject_MVC.Helpers
@using MyFinalProject.Infrastructure.DTO
@model List<AdminAdvertisementTableDto>

@{
    ViewData["Title"] = "آگهی‌های من";

    var total = Model.Count;
    var active = Model.Count(a => a.IsActive);
    var inactive = total - active;
    var featured = Model.Count(a => a.IsFeatured && a.FeaturedUntil.HasValue && a.FeaturedUntil.Value > DateTime.Now);
}

<div class="sb-cards">

    <div class="sb-card sb-card-primary">
        <div class="sb-card-row">
            <div>
                <div class="text-xs">کل آگهی‌ها</div>
                <div class="sb-value">@total</div>
            </div>
            <i class="fa-solid fa-briefcase sb-icon"></i>
        </div>
    </div>

    <div class="sb-card sb-card-success">
        <div class="sb-card-row">
            <div>
                <div class="text-xs">فعال</div>
                <div class="sb-value">@active</div>
            </div>
            <i class="fa-solid fa-circle-check sb-icon"></i>
        </div>
    </div>

    <div class="sb-card sb-card-danger">
        <div class="sb-card-row">
            <div>
                <div class="text-xs">غیرفعال / در انتظار تأیید</div>
                <div class="sb-value">@inactive</div>
            </div>
            <i class="fa-solid fa-clock sb-icon"></i>
        </div>
    </div>

    <div class="sb-card sb-card-warning">
        <div class="sb-card-row">
            <div>
                <div class="text-xs">آگهی‌های ویژه</div>
                <div class="sb-value">@featured</div>
            </div>
            <i class="fa-solid fa-star sb-icon"></i>
        </div>
    </div>

</div>

<div class="sb-table-card">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:.6rem;">
        <h5 style="margin:0;">آگهی‌های من</h5>

        <a asp-controller="Advertisement" asp-action="Create" class="btn-sb btn-sb-primary" style="text-decoration:none;">
            <i class="fa-solid fa-plus"></i> ثبت آگهی جدید
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <table class="sb-table">
        <thead>
            <tr>
                <th>عنوان</th>
                <th>شهر</th>
                <th>تاریخ ثبت</th>
                <th>وضعیت</th>
                <th>ویژه</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" style="text-align:center; color:#858796; padding:2rem 0;">
                        هنوز آگهی‌ای ثبت نکرده‌اید
                    </td>
                </tr>
            }
            else
            {
                @foreach (var ad in Model)
                {
                    bool isFeatured = ad.IsFeatured && ad.FeaturedUntil.HasValue && ad.FeaturedUntil.Value > DateTime.Now;
                    string rowClass = isFeatured ? "table-warning" : "";

                    <tr class="@rowClass">
                        <td>@ad.Title</td>
                        <td>@ad.CityName</td>
                        <td>@DisplayHelper.FormatDate(ad.CreatedAt)</td>
                        <td>
                            @if (ad.IsActive)
                            {
                                <span class="badge badge-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">در انتظار تأیید</span>
                            }
                        </td>
                        <td>
                            @if (isFeatured)
                            {
                                <span class="badge badge-warning">
                                    <i class="fa-solid fa-star"></i>
                                    تا @ad.FeaturedUntil.Value.ToString("yyyy/MM/dd")
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">عادی</span>
                            }
                        </td>
                        <td style="display:flex; gap:.4rem; flex-wrap:wrap;">

                            <a asp-controller="Advertisement" asp-action="Details" asp-route-id="@ad.Id"
                               class="btn-sb btn-sb-primary" style="text-decoration:none;">
                                مشاهده
                            </a>

                            <a asp-controller="Advertisement" asp-action="Edit" asp-route-id="@ad.Id"
                               class="btn-sb btn-sb-info" style="text-decoration:none;">
                                ویرایش
                            </a>

                            @if (isFeatured)
                            {
                                <form asp-controller="Advertisement" asp-action="Unfeature" asp-route-id="@ad.Id"
                                      method="post"
                                      onsubmit="return confirm('آیا از لغو وضعیت ویژه اطمینان دارید؟');">
                                      @Html.AntiForgeryToken()
                                      <input type="hidden" name="id" value="@ad.Id" />
                                    <button type="submit" class="btn-sb" style="background-color: #6c757d; color: white;">
                                      <i class="fa-solid fa-times"></i> لغو ویژه
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Advertisement" asp-action="Feature" asp-route-id="@ad.Id"
                                      method="post"
                                      onsubmit="return confirm('آیا می‌خواهید این آگهی را به مدت ۷ روز ویژه کنید؟');">
                                      @Html.AntiForgeryToken()
                                      <input type="hidden" name="id" value="@ad.Id" />
                                      <input type="hidden" name="days" value="7" />
                                    <button type="submit" class="btn-sb" style="background-color: #f59e0b; color: #1f2937; font-weight: bold;">
                                      <i class="fa-solid fa-star"></i> ویژه کردن
                                    </button>
                                </form>
                            }

                            <form asp-controller="Advertisement" asp-action="DeleteConfirmed" asp-route-id="@ad.Id"
                                  method="post"
                                  onsubmit="return confirm('آیا از حذف این آگهی مطمئن هستید؟');">
                                  @Html.AntiForgeryToken()
                                  <button type="submit" class="btn-sb btn-sb-danger">حذف</button>
                            </form>

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>