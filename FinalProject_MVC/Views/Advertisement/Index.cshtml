@model List<FinalProject_MVC.Models.AdvertisementViewModel>

@{
    ViewData["Title"] = "Advertisements List‌";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-megaphone-fill me-2"></i> Job Advertisements‌ 
        </h2>
        <p class="text-muted mb-0"> Find the best chance for job advertisements </p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="bi bi-plus-circle me-2"></i>Add New Advertisement  
    </a>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var ad in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title text-primary fw-bold mb-0">@ad.Title</h5>
                            <span class="badge bg-success">Active</span>
                        </div>

                        <h6 class="card-subtitle text-muted mb-3">
                            <i class="bi bi-building me-1"></i>@ad.CompanyName
                        </h6>

                        <p class="card-text text-secondary mb-3">
                            @(ad.Description?.Length > 100 ? ad.Description.Substring(0, 100) + "..." : ad.Description)
                        </p>

                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-geo-alt text-primary me-2"></i>
                                <span>@ad.Province - @ad.City</span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-cash-stack text-success me-2"></i>
                                <span class="fw-bold text-success">@ad.Salary.ToString("N0") Tooman</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-event text-info me-2"></i>
                                <span>انقضا: @(ad.ExpireDate.Year > 1 ? ad.ExpireDate.ToString("yyyy/MM/dd") : "Unspecified")</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a asp-action="Details" asp-route-id="@ad.Id" class="btn btn-outline-primary w-100">
                            <i class="bi bi-eye me-1"></i> More Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h3 class="mt-3 text-muted">Not Found Any Advertisements</h3>
        <p class="text-secondary">Record the first advertisement</p>
        <a asp-action="Create" class="btn btn-primary mt-3">
            <i class="bi bi-plus-circle me-2"></i>Add New Advertisement  
        </a>
    </div>
}