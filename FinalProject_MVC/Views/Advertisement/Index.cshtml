@model List<FinalProject_MVC.Models.AdvertisementViewModel>

@{
    ViewData["Title"] = "‌Adverisements List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>‌Job Advertisement List</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add New Advertisement
    </a>
</div>

<div class="container mt-4">

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var ad in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@ad.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@ad.CompanyName</h6>
                            <p class="card-text">@ad.Description</p>
                            <ul class="list-unstyled">
                                <li><strong>CompanyLocation:</strong> @ad.Province - @ad.City</li>
                                <li><strong>Salary:</strong> @ad.Salary Tooman</li>
                                <li>
                                    <strong>ExpireDate</strong>
                                    @(ad.ExpireDate.Year > 1 ? ad.ExpireDate.ToString("yyyy/MM/dd") : "Unspecified")
                                </li>

                                <li>
                                    <strong>CreatedAt</strong>
                                    @(ad.CreatedAt.Year > 1 ? ad.CreatedAt.ToString("yyyy/MM/dd") : "Unspecified")
                                </li>
                            </ul>
                        </div>
                        <a asp-action="Details" asp-route-id="@ad.Id" class="btn btn-outline-primary btn-sm">
                            More Detail
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">Not found any advertisement !</div>
    }
</div>