@using FinalProject_MVC.Helpers
@using MyFinalProject.Infrastructure.DTO
@model List<AdminAdvertisementTableDto>

@{
    ViewData["Title"] = "آگهی‌ها";
}

<div class="sb-table-card">
    <h5>جستجوی شغل</h5>

    <form method="get" asp-controller="Advertisement" asp-action="Index" class="sb-filter-bar">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="عنوان شغل یا مهارت مورد نظر..." />
        <button type="submit" class="btn-sb btn-sb-primary">جستجو</button>
    </form>

    @if (Model.Count == 0)
    {
        <p style="color:#858796; text-align:center; padding:2.5rem 0;">
            <i class="fa-regular fa-folder-open" style="font-size:2rem; display:block; margin-bottom:.7rem;"></i>
            آگهی‌ای یافت نشد
        </p>
    }
    else
    {
        <div class="sb-job-grid">
            @foreach (var job in Model)
            {
                <div class="sb-job-card">
                    <h6>@job.Title</h6>

                    <div class="meta">
                        <span><i class="fa-solid fa-building"></i> @job.EmployerName</span>
                        <span><i class="fa-solid fa-city"></i> @job.CityName</span>
                    </div>

                    <div class="meta">
                        <span><i class="fa-regular fa-calendar"></i> @DisplayHelper.FormatDate(job.CreatedAt)</span>
                    </div>

                    <a asp-controller="Advertisement" asp-action="Details" asp-route-id="@job.Id"
                       class="btn-sb btn-sb-primary" style="text-decoration:none; text-align:center;">
                        مشاهده آگهی
                    </a>
                </div>
            }
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <nav class="sb-pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a class="sb-page @(i == ViewBag.CurrentPage ? "active" : "")"
                       asp-controller="Advertisements"
                       asp-action="Index"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="@i">
                        @i
                    </a>
                }
            </nav>
        }
    }
</div>