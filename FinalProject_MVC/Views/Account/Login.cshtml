@model FinalProject_MVC.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "ورود";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ورود - کارلینو</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin-sb.css" asp-append-version="true" />
</head>
<body class="sb-auth-body">

    <div class="sb-auth-card">

        <div class="sb-auth-header">
            <i class="fa-solid fa-briefcase"></i>
            <h4>ورود به کارلینو</h4>
            <p>خوش برگشتی! اطلاعاتت رو وارد کن</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="sb-error" style="background:#d1e7dd; color:#1cc88a; margin-bottom:1rem;">
                @TempData["Success"]
            </div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="sb-error" style="margin-bottom:1rem;"></div>

            <div class="sb-field">
                <label asp-for="Email">ایمیل</label>
                <input asp-for="Email" type="email" placeholder="example@email.com" />
                <span asp-validation-for="Email" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <div class="sb-field">
                <label asp-for="Password">رمز عبور</label>
                <input asp-for="Password" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <button type="submit" class="sb-submit">
                <i class="fa-solid fa-right-to-bracket"></i> ورود
            </button>
        </form>

        <div class="sb-auth-footer">
            حساب نداری؟ <a href="/Account/Register">ثبت‌نام کن</a>
        </div>

    </div>

</body>
</html>