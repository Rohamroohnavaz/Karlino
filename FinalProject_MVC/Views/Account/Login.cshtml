@model FinalProject_MVC.Models.LoginViewModel

@{
    ViewData["Title"] = "ورود به سیستم";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white text-center py-4">
                <h3 class="mb-0">
                    <i class="bi bi-box-arrow-in-right me-2"></i>ورود به حساب کاربری
                </h3>
            </div>

            <div class="card-body p-5">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold">
                            <i class="bi bi-envelope me-1"></i>ایمیل
                        </label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-bold">
                            <i class="bi bi-lock me-1"></i>رمز عبور
                        </label>
                        <input asp-for="Password" class="form-control form-control-lg" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">
                            مرا به خاطر بسپار
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>ورود
                        </button>
                    </div>
                </form>
            </div>

            <div class="card-footer text-center py-3">
                <span class="text-muted">حساب کاربری ندارید؟ </span>
                <a asp-action="Register" class="text-decoration-none">ثبت‌نام کنید</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}