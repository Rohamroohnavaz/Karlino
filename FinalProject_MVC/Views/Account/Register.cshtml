@model RegisterViewModel

@{
    ViewData["Title"] = "ثبت‌نام";
}

<form asp-action="Register" method="post" id="registerForm">
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <!-- 🎯 انتخاب نوع کاربر -->
    <div class="mb-4">
        <label class="form-label fw-bold">
            <i class="bi bi-people-fill me-1"></i>من ثبت‌نام می‌کنم به عنوان:
        </label>
        <div class="d-flex gap-4">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="IsEmployer" id="roleJobSeeker" value="false" @(Model.IsEmployer ? "" : "checked") />
                <label class="form-check-label" for="roleJobSeeker">
                    <i class="bi bi-person-workspace"></i> کارجو (جستجوی شغل)
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="IsEmployer" id="roleEmployer" value="true" @(Model.IsEmployer ? "checked" : "") />
                <label class="form-check-label" for="roleEmployer">
                    <i class="bi bi-building"></i> کارفرما (درج آگهی)
                </label>
            </div>
        </div>
    </div>

    <!-- 👤 اطلاعات شخصی -->
    <h6 class="text-muted mb-3">اطلاعات شخصی</h6>
    <div class="row">
        <div class="col-md-6 mb-4">
            <label asp-for="FirstName" class="form-label fw-bold">
                <i class="bi bi-person me-1"></i>نام
            </label>
            <input asp-for="FirstName" class="form-control" placeholder="مثلاً: رهام" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-4">
            <label asp-for="LastName" class="form-label fw-bold">
                <i class="bi bi-person me-1"></i>نام خانوادگی
            </label>
            <input asp-for="LastName" class="form-control" placeholder="مثلاً: روح نواز" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="Email" class="form-label fw-bold">
            <i class="bi bi-envelope me-1"></i>ایمیل
        </label>
        <input asp-for="Email" class="form-control" placeholder="example@email.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
        <div class="form-text">ایمیل خود را با دقت وارد کنید</div>
    </div>

    <div class="mb-4">
        <label asp-for="PhoneNumber" class="form-label fw-bold">
            <i class="bi bi-telephone me-1"></i>شماره تلفن
        </label>
        <input asp-for="PhoneNumber" class="form-control" placeholder="مثلاً: 09123456789" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <label asp-for="Password" class="form-label fw-bold">
                <i class="bi bi-lock me-1"></i>رمز عبور
            </label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="form-text small">حداقل ۸ کاراکتر، شامل حرف بزرگ، کوچک و عدد</div>
        </div>

        <div class="col-md-6 mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-bold">
                <i class="bi bi-lock-fill me-1"></i>تایید رمز عبور
            </label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>

    <!-- 🏢 اطلاعات شرکت (فقط برای کارفرما) -->
    <div id="employerFields" style="display: @(Model.IsEmployer ? "block" : "none");">
        <hr />
        <h6 class="text-muted mb-3">
            <i class="bi bi-building"></i> اطلاعات شرکت
        </h6>

        <div class="mb-4">
            <label asp-for="CompanyName" class="form-label fw-bold">نام شرکت</label>
            <input asp-for="CompanyName" class="form-control" placeholder="مثلاً: شرکت فناوری نوین" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="CompanyLocation" class="form-label fw-bold">آدرس شرکت</label>
            <textarea asp-for="CompanyLocation" class="form-control" rows="2" placeholder="آدرس کامل شرکت"></textarea>
            <span asp-validation-for="CompanyLocation" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="Province" class="form-label fw-bold">استان</label>
                <input asp-for="Province" class="form-control" placeholder="مثلاً: تهران" />
                <span asp-validation-for="Province" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-4">
                <label asp-for="City" class="form-label fw-bold">شهر</label>
                <input asp-for="City" class="form-control" placeholder="مثلاً: تهران" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
        </div>
    </div>

    <hr />

    <div class="mb-4 form-check">
        <input type="checkbox" class="form-check-input" id="acceptTerms" required />
        <label class="form-check-label" for="acceptTerms">
            <a href="#" class="text-primary">قوانین و مقررات</a> را مطالعه کرده و می‌پذیرم
        </label>
    </div>

    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-check-circle me-2"></i>ثبت‌نام
        </button>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const radios = document.querySelectorAll('input[name="IsEmployer"]');
            const employerFields = document.getElementById('employerFields');

            function toggleEmployerFields() {
                const isEmployer = document.getElementById('roleEmployer').checked;
                employerFields.style.display = isEmployer ? 'block' : 'none';

                // فیلدها رو required کن یا آزاد کن
                const inputs = employerFields.querySelectorAll('input, textarea');
                inputs.forEach(input => {
                    if (isEmployer) {
                        input.setAttribute('required', 'required');
                    } else {
                        input.removeAttribute('required');
                    }
                });
            }

            radios.forEach(radio => {
                radio.addEventListener('change', toggleEmployerFields);
            });

            // بار اول هم اجرا کن
            toggleEmployerFields();
        });
    </script>
}