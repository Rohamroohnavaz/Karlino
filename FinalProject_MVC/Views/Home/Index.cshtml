@using FinalProject_MVC.Helpers
@using MyFinalProject.Infrastructure.DTO

@{
    ViewData["Title"] = "صفحه اصلی";

    var latest = ViewBag.LatestJobs as List<AdminAdvertisementTableDto>
                 ?? new List<AdminAdvertisementTableDto>();
}

<div class="sb-cards">

    <div class="sb-card sb-card-success">
        <div class="sb-card-row">
            <div>
                <div class="text-xs">آگهی فعال</div>
                <div class="sb-value">@ViewBag.ActiveJobs</div>
            </div>
            <i class="fa-solid fa-briefcase sb-icon"></i>
        </div>
    </div>

    <div class="sb-card sb-card-info">
        <div class="sb-card-row">
            <div>
                <div class="text-xs">کارفرما</div>
                <div class="sb-value">@ViewBag.Employers</div>
            </div>
            <i class="fa-solid fa-building sb-icon"></i>
        </div>
    </div>

    <div class="sb-card sb-card-primary">
        <div class="sb-card-row">
            <div>
                <div class="text-xs">کارجو</div>
                <div class="sb-value">@ViewBag.JobSeekers</div>
            </div>
            <i class="fa-solid fa-users sb-icon"></i>
        </div>
    </div>

</div>

<div class="sb-table-card">
    <h5>آخرین آگهی‌های فعال</h5>

    @if (latest.Count == 0)
    {
        <p style="color:#858796; text-align:center; padding:2rem 0;">
            هنوز آگهی فعالی ثبت نشده است
        </p>
    }
    else
    {
        <div class="sb-job-grid">
                @foreach (var job in latest)
                {
                    bool isFeatured = job.IsFeatured && job.FeaturedUntil.HasValue && job.FeaturedUntil.Value > DateTime.Now;
                    string featuredClass = isFeatured ? "sb-job-card-featured" : "";
                    string featuredBadge = isFeatured ? "<div class='sb-featured-badge'><i class='fa-solid fa-star'></i> ویژه</div>" : "";

                    <div class="sb-job-card @featuredClass">
                        @Html.Raw(featuredBadge)

                        <h6>@job.Title</h6>
                        <div class="meta">
                            <span><i class="fa-solid fa-building"></i> @job.EmployerName</span>
                            <span><i class="fa-solid fa-city"></i> @job.CityName</span>
                        </div>
                        <div class="meta">
                            <span><i class="fa-regular fa-calendar"></i> @DisplayHelper.FormatDate(job.CreatedAt)</span>
                            @if (isFeatured)
                            {
                                <span style="color:#f59e0b; font-weight:bold;">
                                    <i class="fa-solid fa-star"></i> تا @job.FeaturedUntil.Value.ToString("yyyy/MM/dd")
                                </span>
                            }
                        </div>
                        <a asp-controller="Advertisement" asp-action="Details" asp-route-id="@job.Id"
                           class="btn-sb btn-sb-primary" style="text-decoration:none; text-align:center;">
                            مشاهده آگهی
                        </a>
                    </div>
                }
            </div>
    }
</div>